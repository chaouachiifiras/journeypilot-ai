# Copy this file to .env and fill in real values. Never commit the real .env.

# Supabase (Lovable Cloud) — anon/publishable keys only, safe for client exposure.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Google Maps (browser-side autocomplete widget)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY="your-google-maps-browser-key"
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID="your-tracking-id"

# RevenueCat (Android in-app subscription) — public SDK key, safe for client exposure.
VITE_REVENUECAT_ANDROID_SDK_KEY="your-revenuecat-public-android-key"

# --- Server-only secrets — do NOT put these here; they live in Lovable Cloud's
# --- own project secrets panel (Settings > Secrets), injected at deploy time:
#   LOVABLE_API_KEY            — AI gateway
#   GOOGLE_MAPS_API_KEY        — server-side Places lookups
#   REVENUECAT_SECRET_API_KEY  — server-side subscription entitlement checks
